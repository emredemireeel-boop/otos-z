SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
CRON_TZ=UTC

# Enable Search Console API and grant this read-only service account site access first.
# Keep the credential outside Git; adjust path for the actual host before installing.
# The verified Ubuntu cron host uses Etc/UTC. 06:10 UTC = 09:10 Europe/Istanbul.
10 6 * * 1 root cd /var/www/otos-z && GOOGLE_APPLICATION_CREDENTIALS=/etc/otosoz/search-console.json /usr/bin/flock -n /tmp/otosoz-seo-weekly.lock /usr/local/bin/node scripts/seo-weekly-report.mjs >> /var/log/otosoz-seo-weekly.log 2>&1
