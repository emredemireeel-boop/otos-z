rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userRole() {
      return currentUser().get('role', 'caylak');
    }

    function isAdmin() {
      return isSignedIn() && userRole() == 'admin';
    }

    function isModerator() {
      return isSignedIn() && userRole() == 'moderator';
    }

    function isAdminOrMod() {
      return isAdmin() || isModerator();
    }

    function isActiveUser() {
      return isSignedIn()
        && (
          currentUser().get('banned', false) != true
          || (
            currentUser().get('bannedUntil', null) != null
            && currentUser().bannedUntil <= request.time
          )
        );
    }

    match /users/{userId} {
      // Bu belge yalnızca kamu profili alanlarını içerir. E-posta user_private'a taşınır.
      allow read: if true;

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.get('role', 'caylak') in ['caylak', 'standard']
        && request.resource.data.get('banned', false) == false
        && !request.resource.data.keys().hasAny([
          'email', 'permissions', 'warnings', 'ratingTotalScore', 'ratingCount',
          'ratingAverage', 'bannedAt', 'bannedUntil', 'banReason'
        ]);

      allow update: if
        isAdmin()
        || (
          isModerator()
          && request.auth.uid != userId
          && !(resource.data.get('role', 'caylak') in ['admin', 'moderator'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'banned', 'bannedAt', 'bannedUntil', 'banReason',
            'warnings', 'lastWarningAt', 'lastWarningReason'
          ])
        )
        || (
          isActiveUser()
          && request.auth.uid == userId
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'email', 'role', 'permissions', 'banned', 'bannedAt', 'bannedUntil',
            'banReason', 'warnings', 'lastWarningAt', 'lastWarningReason',
            'ratingTotalScore', 'ratingCount', 'ratingAverage'
          ])
        );

      allow delete: if isAdmin() && request.auth.uid != userId;
    }

    match /user_private/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['email', 'updatedAt', 'migratedAt'])
        && request.resource.data.get('email', '') == request.auth.token.email;
      allow delete: if isAdmin();
    }

    match /threads/{threadId} {
      allow read: if true;
      allow create: if isActiveUser()
        && request.resource.data.authorId == request.auth.uid;
      allow update: if
        isAdminOrMod()
        || (
          isActiveUser()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'views', 'entryCount', 'lastEntryAt', 'vehicleVotes', 'chronicIssues'
          ])
        )
        || (
          isActiveUser()
          && resource.data.authorId == request.auth.uid
          && request.resource.data.authorId == resource.data.authorId
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'pinned', 'locked', 'trending', 'authorId', 'createdAt'
          ])
        );
      allow delete: if isAdminOrMod()
        || (isActiveUser() && resource.data.authorId == request.auth.uid);

      match /entries/{entryId} {
        allow read: if true;
        allow create: if isActiveUser()
          && request.resource.data.authorId == request.auth.uid;
        allow update: if
          isAdminOrMod()
          || (
            isActiveUser()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy'])
          )
          || (
            isActiveUser()
            && resource.data.authorId == request.auth.uid
            && request.resource.data.authorId == resource.data.authorId
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['authorId', 'createdAt'])
          );
        allow delete: if isAdminOrMod()
          || (isActiveUser() && resource.data.authorId == request.auth.uid);
      }
    }

    match /conversations/{convId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isActiveUser()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants;
      allow update: if isActiveUser()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.participantUsernames == resource.data.participantUsernames
        && request.resource.data.lastSenderId == request.auth.uid
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 2000
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage', 'lastMessageAt', 'lastSenderId'
        ]);
      allow delete: if false;

      match /messages/{msgId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
        allow create: if isActiveUser()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 2000;
        allow update, delete: if false;
      }
    }

    match /notifications/{notifId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isActiveUser()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.message is string
        && request.resource.data.title.size() <= 120
        && request.resource.data.message.size() <= 1000;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt', 'seen']);
      allow delete: if false;
    }

    match /surveys/{surveyId} {
      allow read: if true;
      allow create: if isAdmin()
        || (
          isActiveUser()
          && request.resource.data.status == 'pending'
          && request.resource.data.createdById == request.auth.uid
          && request.resource.data.totalVotes == 0
          && request.resource.data.nominees is list
          && request.resource.data.nominees.size() >= 2
          && request.resource.data.nominees.size() <= 10
        );
      allow update: if isAdmin()
        || (
          isActiveUser()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nominees', 'totalVotes', 'voters'])
          && request.resource.data.nominees.size() == resource.data.nominees.size()
          && request.resource.data.totalVotes >= resource.data.totalVotes
          && request.resource.data.totalVotes <= resource.data.totalVotes + 1
          && request.resource.data.voters.diff(resource.data.get('voters', {})).affectedKeys().hasOnly([request.auth.uid])
        );
      allow delete: if isAdmin();
    }

    match /comparisons/{compId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /vehicle_chronic_issues/{vehicleId} {
      allow read: if true;
      allow create: if isActiveUser()
        && request.resource.data.keys().hasOnly(['brandSlug', 'modelSlug', 'chronicIssues', 'staticIssueVotes'])
        && request.resource.data.chronicIssues is list
        && request.resource.data.chronicIssues.size() <= 1;
      allow update: if isActiveUser()
        && request.resource.data.brandSlug == resource.data.brandSlug
        && request.resource.data.modelSlug == resource.data.modelSlug
        && request.resource.data.chronicIssues is list
        && request.resource.data.chronicIssues.size() <= 10
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['chronicIssues', 'staticIssueVotes']);
      allow delete: if isAdmin();
    }

    match /dna_chronic_reports/{reportId} {
      allow read: if isAdminOrMod();
      allow create: if isActiveUser()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'bekliyor'
        && request.resource.data.issueTitle is string
        && request.resource.data.issueTitle.size() <= 160
        && request.resource.data.issueDescription is string
        && request.resource.data.issueDescription.size() <= 3000;
      allow update, delete: if isAdminOrMod();
    }

    match /userRatings/{ratingId} {
      allow read: if isSignedIn();
      allow create: if isActiveUser()
        && request.resource.data.raterId == request.auth.uid
        && request.resource.data.targetUserId != request.auth.uid
        && request.resource.data.score is number
        && request.resource.data.score >= 1
        && request.resource.data.score <= 5;
      allow update: if isActiveUser()
        && resource.data.raterId == request.auth.uid
        && request.resource.data.raterId == resource.data.raterId
        && request.resource.data.targetUserId == resource.data.targetUserId
        && request.resource.data.score is number
        && request.resource.data.score >= 1
        && request.resource.data.score <= 5
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['score', 'updatedAt']);
      allow delete: if false;
    }

    match /reports/{reportId} {
      allow create: if isActiveUser();
      allow read, update: if isAdminOrMod();
      allow delete: if false;
    }

    match /admin_logs/{logId} {
      allow read, write: if isAdmin();
    }

    match /dictionary/{termId} {
      allow read: if true;
      allow write: if isAdminOrMod();
    }

    match /advertisements/{adId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /businesses/{businessId} {
      allow read: if resource.data.approved == true || isAdminOrMod();
      allow create: if isActiveUser()
        && request.resource.data.addedBy == request.auth.uid
        && request.resource.data.approved == false;
      allow update, delete: if isAdminOrMod();
    }

    match /pending_events/{eventId} {
      allow read: if isAdminOrMod();
      allow create: if isActiveUser();
      allow update, delete: if isAdminOrMod();
    }

    match /userQuests/{questId} {
      allow read, write: if isActiveUser() && request.auth.uid == questId;
    }

    match /user_settings/{settingId} {
      allow read, write: if isActiveUser() && request.auth.uid == settingId;
    }

    match /guvenmetre_reviews/{reviewId} {
      allow read: if true;
      allow create: if false;
      allow update, delete: if isAdminOrMod();
    }

    match /bad_words/{wordId} {
      allow read: if true;
      allow write: if isAdminOrMod();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /badges/{badgeId} {
      allow read: if true;
      allow write: if isAdminOrMod();
    }

    match /broadcasts/{bcId} {
      allow read, write: if isAdmin();
    }

    match /expert_applications/{appId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdminOrMod());
      allow create: if isActiveUser()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'bekliyor';
      allow update, delete: if isAdminOrMod();
    }
  }
}
