rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Kullanıcılar
    match /users/{userId} {
      allow read: if true;
      // Kendi profilini tamamen yazabilir
      // Admin ve Moderatörler her kullanıcıyı güncelleyebilir, kendi profilini yazabilir
      allow write: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'moderator'] ||
        (request.auth.uid != userId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratingTotalScore', 'ratingCount', 'ratingAverage']))
      );
    }
                          
    // Konu Başlıkları (Threads) ve Altındaki Girdiler (Entries)
    // ✅ GÜVENLİK: Güncelleme → topluluk alanları (views, entryCount, oy) herkese açık,
    //    içerik değişikliği ve silme sadece sahip veya admin/moderatör
    match /threads/{threadId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        // Topluluk etkileşim alanları: görüntüleme, entry sayısı, oylar, kronik sorunlar
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['views', 'entryCount', 'lastEntryAt', 'vehicleVotes', 'chronicIssues']
        ) ||
        // İçerik düzenleme: sadece yazar veya admin/moderatör
        resource.data.authorId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'moderator']
      );
      allow delete: if request.auth != null && (
        resource.data.authorId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'moderator']
      );
      
      match /entries/{entryId} {
        allow read: if true;
        allow create: if request.auth != null;
        allow update: if request.auth != null && (
          // Beğeni alanları: herkes beğenebilir
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ['likes', 'likedBy']
          ) ||
          // İçerik düzenleme: sadece yazar veya admin/moderatör
          resource.data.authorId == request.auth.uid ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'moderator']
        );
        allow delete: if request.auth != null && (
          resource.data.authorId == request.auth.uid ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'moderator']
        );
      }
    }

    // Sohbetler (Conversations) ve Mesajlar
    // ✅ GÜVENLİK: Sadece sohbete katılan kullanıcılar erişebilir
    match /conversations/{convId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow delete: if false; // Sohbet silinemez
      
      match /messages/{msgId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
        allow update, delete: if false; // Mesajlar değiştirilemez/silinemez
      }
    }

    // Bildirimler
    // ✅ GÜVENLİK: Sadece kendi bildirimlerini okuyabilir/güncelleyebilir
    match /notifications/{notifId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // Anketler (Surveys)
    // ✅ GÜVENLİK: Anket oluşturma/silme sadece admin, oy verme (update) üyeler
    match /surveys/{surveyId} {
      allow read: if true;
      allow create, delete: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin'];
      allow update: if request.auth != null;
    }

    // Karşılaştırmalar (Comparisons)
    // ✅ GÜVENLİK: Yazma sadece admin
    match /comparisons/{compId} {
      allow read: if true;
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin'];
    }

    // Araç DNA Kronik Sorunlar & Oylar
    match /vehicle_chronic_issues/{vehicleId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // DNA Kronik Sorun Bildirimleri (Admin Onay Kuyruğu)
    // ✅ GÜVENLİK: Okuma/güncelleme/silme sadece admin
    match /dna_chronic_reports/{reportId} {
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'moderator'];
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'moderator'];
    }

    // Kullanıcı Puanları
    // ✅ GÜVENLİK: Herkes okuyabilir (profilde gösterilir), oluşturma üyeler, güncelleme yok
    match /userRatings/{ratingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && resource.data.raterId == request.auth.uid;
      allow delete: if false;
    }

    // Raporlar / Şikayetler
    // ✅ GÜVENLİK: Oluşturma herkes, okuma/güncelleme sadece admin
    match /reports/{reportId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'moderator'];
      allow delete: if false;
    }

    // Admin Logları
    // ✅ GÜVENLİK: Sadece admin okuyup yazabilir
    match /admin_logs/{logId} {
      allow read, write: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin'];
    }

    // Sözlük
    // ✅ GÜVENLİK: Yazma sadece admin/moderatör
    match /dictionary/{termId} {
      allow read: if true;
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'moderator'];
    }

    // Reklamlar
    // ✅ GÜVENLİK: Yazma sadece admin
    match /advertisements/{adId} {
      allow read: if true;
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin'];
    }

    // İşletme Başvuruları
    // ✅ GÜVENLİK: Onaylama/silme sadece admin
    match /businesses/{businessId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'moderator'];
    }

    // Etkinlik Önerileri
    // ✅ GÜVENLİK: Onaylama/silme sadece admin
    match /pending_events/{eventId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'moderator'];
    }

    // Kullanıcı Görevleri (Quests)
    match /userQuests/{questId} {
      allow read: if request.auth != null && request.auth.uid == questId;
      allow write: if request.auth != null && request.auth.uid == questId;
    }

    // Kullanıcı Ayarları (Bakım Takvimi vb.)
    match /user_settings/{settingId} {
      allow read: if request.auth != null && request.auth.uid == settingId;
      allow write: if request.auth != null && request.auth.uid == settingId;
    }

    // GüvenMetre Değerlendirmeleri
    // ✅ GÜVENLİK: Güncelleme/silme sadece admin
    match /guvenmetre_reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'moderator'];
    }

  }
}
